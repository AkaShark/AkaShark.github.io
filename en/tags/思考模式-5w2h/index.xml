    <item>
      <title>最近的一些感悟 (20221001)</title>
      <link>https://akashark.github.io/en/posts/life/%E6%80%9D%E8%80%83/20221001/</link>
      <pubDate>Sat, 01 Oct 2022 23:26:29 +0800</pubDate>
